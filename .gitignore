# The data home: the release and the export's files are never tracked; the simulation (3.5 MB) is.
/data/export
/data/hub
/data/v1/release/*
!/data/v1/release/.gitkeep
*.jsonl
*.parquet
!/data/v1/simulation/**/*.parquet

# The salt, the provider letters and the export's settings.
/private/

# The maintainer's working files.
/huggingface_export/
/tests/
/openspec/
/.claude/
/CLAUDE.md

# Numbers the paper quotes, regenerated with the figures.
/figures/v1/numbers.json

# Tools.
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Scratch analyses, not part of the package.
/exploration/
